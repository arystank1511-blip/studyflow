# LOCAL: existing private SQLite workspace, loopback only. NEVER host this mode publicly.
STUDYFLOW_MODE=local
# CLOUD: set STUDYFLOW_MODE=cloud and fill the next three values (also for Vercel).
SUPABASE_URL=
# Publishable key or legacy anon key ONLY; never service_role / sb_secret_...
SUPABASE_PUBLISHABLE_KEY=
# Generate a random secret (at least 32 characters). Do not commit the actual .env.
STUDYFLOW_SECRET_KEY=
# Exact hostnames, comma-separated, no https://. Vercel's deployment hosts are added automatically.
STUDYFLOW_ALLOWED_HOSTS=
# Use 1 for HTTPS outside Vercel. Vercel always enables Secure cookies automatically.
STUDYFLOW_HTTPS=0
# Optional: fallback timezone until the browser reports its own
STUDYFLOW_TIMEZONE=Asia/Almaty
# Optional: set to 1 after the Google provider is configured in Supabase
STUDYFLOW_GOOGLE_LOGIN=0
# Cloudflare Turnstile site key; enable captcha with the secret in Supabase first.
TURNSTILE_SITE_KEY=
# Sentry error monitoring (optional). Events carry no task data, emails, cookies or form fields.
SENTRY_DSN=
# Morning reminders (Web Push). Generate with: python tools/make_push_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# Optional: Google Gemini API key for reading timetable photos (aistudio.google.com; never commit a real key)
GEMINI_API_KEY=
